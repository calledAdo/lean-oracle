TESTNET_CKB_RPC_URL=
TESTNET_DEPLOYER_PRIVATE_KEY=

MAINNET_CKB_RPC_URL=
MAINNET_DEPLOYER_PRIVATE_KEY=

DEVNET_CKB_RPC_URL=
DEVNET_DEPLOYER_PRIVATE_KEY=

# Devnet-only secp256k1_blake160 KnownScript override.
# Populate these from your local chain's system script deployment
# (for example via `offckb system-scripts`).
DEVNET_SECP256K1_BLAKE160_CODE_HASH=
DEVNET_SECP256K1_BLAKE160_HASH_TYPE=
DEVNET_SECP256K1_BLAKE160_DEP_TX_HASH=
DEVNET_SECP256K1_BLAKE160_DEP_INDEX=
DEVNET_SECP256K1_BLAKE160_DEP_TYPE=

# Default network if `--network` is omitted.
DEPLOY_NETWORK=devnet
BROADCAST=false
# Defaults to dry-run unless explicitly set to false.
DRY_RUN=true

# One-off overrides used by `deploy:oracle`.
ORACLE_FEED_ID=
ORACLE_EMITTER_CHAIN=
ORACLE_EMITTER_ADDRESS=

# One-off overrides used by `rotate:guardian-set`.
GUARDIAN_UPGRADE_VAA=
# Optional; defaults to the canonical deploy-guardian-set artifact's Type ID args.
GUARDIAN_SET_TYPE_ID_ARGS=
